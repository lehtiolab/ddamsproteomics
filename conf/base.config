singularity.enabled = false
docker.enabled = false

process {

  resourceLimits = [
      memory: 128.GB,
      cpus: 256,
      time: 7.d,
  ]

  cpus = 1
  memory = 16.GB
  time = 2.h

  withName: msgfPlus {
    cpus = 2
    time = { 6.h * task.attempt }
    memory = { (db.size() >> 30) < 1 ? 16.GB : "${db.size() * 16}B"  }
  }
  withName: sage {
    cpus = 2
    memory = { (db.size() >> 30) < 1 ? 16.GB : "${db.size() * 16}B"  }
  }
  withName: luciphorPTMLocalizationScoring {
    cpus = 2
  }
}
